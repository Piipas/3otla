# Public origin of the site, used for links in API responses and .ics feeds.
NEXT_PUBLIC_SITE_URL=https://3otla.ma

# Upstash Redis (rate limiting). Leave empty to disable rate limiting (local dev).
# The Vercel Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rate limits per IP (abuse protection only). Defaults shown.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_DAY=2000
# .ics feeds are polled by calendar apps, often from shared IPs (e.g. Google's servers).
ICS_RATE_LIMIT_PER_MINUTE=120
ICS_RATE_LIMIT_PER_DAY=20000

# Optional: public repository URL, linked from the footer and sources page.
NEXT_PUBLIC_REPO_URL=
