{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "holidays.schema.json",
  "title": "3otla holiday rules for one calendar",
  "type": "object",
  "required": ["calendar", "holidays"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "calendar": { "$ref": "#/$defs/calendar" },
    "holidays": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/holiday" } }
  },
  "$defs": {
    "calendar": { "enum": ["national", "religious", "school-public", "school-aefe"] },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "httpsUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "labels": {
      "type": "object",
      "required": ["ar", "fr", "en"],
      "additionalProperties": false,
      "properties": {
        "ar": { "type": "string", "minLength": 1 },
        "fr": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "decisionRef": {
      "type": "object",
      "required": ["ref"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["decree", "royal-decision", "ministerial-decision"] },
        "scope": { "enum": ["all", "public-sector", "private-sector"] },
        "url": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "holiday": {
      "type": "object",
      "required": [
        "id",
        "calendar",
        "type",
        "month",
        "day",
        "durationDays",
        "labels",
        "sourceUrl",
        "validFrom"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "calendar": { "$ref": "#/$defs/calendar" },
        "type": { "enum": ["fixed", "hijri"] },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "day": { "type": "integer", "minimum": 1, "maximum": 31 },
        "durationDays": { "type": "integer", "minimum": 1, "maximum": 7 },
        "labels": { "$ref": "#/$defs/labels" },
        "sourceUrl": { "$ref": "#/$defs/httpsUrl" },
        "decisionRefs": { "type": "array", "items": { "$ref": "#/$defs/decisionRef" } },
        "validFrom": { "$ref": "#/$defs/isoDate" },
        "validTo": { "$ref": "#/$defs/isoDate" }
      },
      "if": { "properties": { "type": { "const": "hijri" } } },
      "then": { "properties": { "day": { "type": "integer", "maximum": 30 } } }
    }
  }
}
